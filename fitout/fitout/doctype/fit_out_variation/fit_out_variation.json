 "fields": [
  {
   "bold": 1,
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Variation Title",
   "reqd": 1
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Project",
   "options": "Project",
   "reqd": 1
  },
  {
   "fetch_from": "project.project_name",
   "fieldname": "project_name",
   "fieldtype": "Data",
   "label": "Project Name",
   "read_only": 1
  },
  {
   "fetch_from": "project.company",
   "fieldname": "company",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Company",
   "options": "Company",
   "read_only": 1
  },
  {
   "fetch_from": "project.customer",
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Client",
   "options": "Customer",
   "read_only": 1
  },
  {
   "fieldname": "col1",
   "fieldtype": "Column Break"
  },
  {
   "default": "Draft",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "Draft\nSubmitted to Client\nUnder Review\nApproved\nRejected\nCancelled",
   "reqd": 1
  },
  {
   "default": "Addition",
   "fieldname": "variation_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Addition\nOmission\nSubstitution\nRate Change"
  },
  {
   "fieldname": "raised_by",
   "fieldtype": "Select",
   "label": "Request Source",
   "options": "Client\nContractor\nConsultant\nDesign Revision\nSite Condition\nAuthority"
  },
  {
   "default": "Today",
   "fieldname": "raised_on",
   "fieldtype": "Date",
   "label": "Raised On"
  },
  {
   "description": "Value charged to the client (negative for omissions).",
   "fieldname": "value",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "label": "Proposed Selling Value"
  },
  {
   "description": "Change to the project cost budget if approved (negative for omissions).",
   "fieldname": "cost_impact",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "label": "Cost Impact"
  },
  {
   "description": "Client change order / approval number, e.g. CO-PRJ001-001",
   "fieldname": "approval_reference",
   "fieldtype": "Data",
   "label": "Approval Reference"
  },
  {
   "fieldname": "workflow_section",
   "fieldtype": "Section Break",
   "label": "Approval Workflow"
  },
  {
   "fieldname": "scope_reviewed_on",
   "fieldtype": "Date",
   "label": "Scope Reviewed"
  },
  {
   "fieldname": "cost_assessed_on",
   "fieldtype": "Date",
   "label": "Cost Assessed"
  },
  {
   "fieldname": "quotation_issued_on",
   "fieldtype": "Date",
   "label": "Client Quotation Issued"
  },
  {
   "fieldname": "quotation",
   "fieldtype": "Link",
   "label": "Client Quotation",
   "options": "Quotation"
  },
  {
   "fieldname": "wf_col",
   "fieldtype": "Column Break"
  },
  {
   "description": "Set automatically when the value exceeds the threshold in Fit Out Settings.",
   "fieldname": "management_approval_required",
   "fieldtype": "Check",
   "label": "Management Approval Required",
   "read_only": 1
  },
  {
   "depends_on": "management_approval_required",
   "fieldname": "management_approved_by",
   "fieldtype": "Link",
   "label": "Management Approved By",
   "options": "User"
  },
  {
   "depends_on": "management_approval_required",
   "fieldname": "management_approved_on",
   "fieldtype": "Date",
   "label": "Management Approved On"
  },
  {
   "fieldname": "action_section",
   "fieldtype": "Section Break",
   "label": "Next Action"
  },
  {
   "description": "Shown on the dashboard, e.g. Review the variation with client.",
   "fieldname": "next_action",
   "fieldtype": "Data",
   "label": "Next Action"
  },
  {
   "fieldname": "action_owner",
   "fieldtype": "Link",
   "label": "Action Owner",
   "options": "User"
  },
  {
   "fieldname": "col2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "action_due",
   "fieldtype": "Date",
   "label": "Action Due"
  },
  {
   "depends_on": "eval:in_list(['Approved','Rejected'], doc.status)",
   "fieldname": "decision_date",
   "fieldtype": "Date",
   "label": "Client Decision Date"
  },
  {
   "fieldname": "details_section",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description"
  },
  {
   "fieldname": "attachment",
   "fieldtype": "Attach",
   "label": "Supporting Document"
  }
 ],
